{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ideation-schema.json",
  "title": "Ideation Architecture card",
  "description": "One ideation tactic. The five-minute sprint is the card: it is the only field a person can execute, it prints verbatim on the front and it is never trimmed. Bounds are the measured source range with headroom, not a style guide.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sourceTacticNo",
    "name",
    "phase",
    "sprint",
    "sprintSize",
    "schematic",
    "mechanism",
    "questions",
    "example",
    "origin",
    "figure"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IDE-(0[1-9]|[1-4][0-9]|50)$"
    },
    "sourceTacticNo": {
      "description": "The tactic's position in the source's own section order; the deck prints in that order.",
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 90
    },
    "phase": {
      "enum": [
        "Systematic Lateral Thinking & Perceptual Restructuring",
        "Algorithmic & Systematic Innovation (TRIZ & Morphological Analysis)",
        "Constraints & Oblique Sparks",
        "Combinatorial & Associative Prompts"
      ]
    },
    "sprint": {
      "description": "The source's 5-Minute Sprint, verbatim. Measured 145-227 characters; this bound admits no paraphrase and no dropped instruction. It is the card's reason to exist and is never trimmed.",
      "type": "string",
      "minLength": 120,
      "maxLength": 300
    },
    "sprintSize": {
      "description": "The point size the front sprint prints at on this card. The layout map is the authority; the deck test asserts the two agree, and the size never falls below 6.5 pt.",
      "type": "number",
      "minimum": 6.5,
      "maximum": 9
    },
    "schematic": {
      "description": "The line the card prints under the figure. It names the drawing, so a reader can see that the label and the picture are the same claim.",
      "type": "string",
      "minLength": 8,
      "maxLength": 60
    },
    "mechanism": {
      "description": "The cognitive mechanism the tactic works by and the failure it breaks, as the source states it. Measured 114-228 characters; carried by the back and the artifacts.",
      "type": "string",
      "minLength": 90,
      "maxLength": 300
    },
    "questions": {
      "description": "Exactly three divergent seed questions, which convert the tactic into an action on the reader's own problem. The source's schema requires three and the deck drops none.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 40,
        "maxLength": 200
      }
    },
    "example": {
      "description": "The domain and the worked technical example. It is illustrative rather than executable, so it lives unbounded in the artifacts and is never compressed into something that no longer illustrates the tactic.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "text"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 5,
          "maxLength": 90
        },
        "text": {
          "description": "Measured 239-493 characters; the bound is the source's range with headroom, not a summary.",
          "type": "string",
          "minLength": 200,
          "maxLength": 600
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "authors"
          ]
        },
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "note"
          ]
        },
        {
          "required": [
            "works"
          ]
        }
      ],
      "properties": {
        "works": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "authors"
                ]
              },
              {
                "required": [
                  "title"
                ]
              },
              {
                "required": [
                  "note"
                ]
              }
            ],
            "properties": {
              "authors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "year": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              "title": {
                "type": "string",
                "minLength": 2
              },
              "publication": {
                "type": "string",
                "minLength": 2
              },
              "note": {
                "type": "string",
                "minLength": 10,
                "maxLength": 160
              }
            }
          }
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "publication": {
          "type": "string",
          "minLength": 2
        },
        "note": {
          "type": "string",
          "minLength": 10,
          "maxLength": 160
        }
      }
    },
    "figure": {
      "description": "The drawing and the parameters it reads. The vocabulary is fixed by decks/ideation/data/layout-map.json at the second checkpoint; until then the shape name is checked, not enumerated.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "svgShape",
        "parametricParams"
      ],
      "properties": {
        "svgShape": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "parametricParams": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
