{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/retrospectives-schema.json",
  "title": "Retrospective Architecture card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "trigger",
    "canvas",
    "timebox",
    "canvasLine",
    "steps",
    "action",
    "provenance",
    "sourceProtocol",
    "origin",
    "figure"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^R(0[1-9]|[1-3][0-9]|4[0-5])$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 70
    },
    "category": {
      "enum": [
        "Foundation & Rhythm",
        "Metaphor & Systems",
        "Incident Diagnostics",
        "Forward-Looking",
        "Psychological Safety"
      ]
    },
    "trigger": {
      "type": "string",
      "minLength": 30,
      "maxLength": 260
    },
    "canvas": {
      "type": "string",
      "minLength": 10,
      "maxLength": 90
    },
    "timebox": {
      "type": "string",
      "minLength": 5,
      "maxLength": 12
    },
    "canvasLine": {
      "type": "string",
      "minLength": 20,
      "maxLength": 100
    },
    "steps": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 25,
            "maxLength": 105
          }
        }
      }
    },
    "action": {
      "type": "string",
      "minLength": 60,
      "maxLength": 230
    },
    "provenance": {
      "enum": [
        "Source protocol: the phases and minutes follow the written sequence in the source.",
        "Source names the canvas and the intent and leaves the phases' wording and minutes to the facilitator."
      ]
    },
    "sourceProtocol": {
      "type": "boolean"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "authors"
          ]
        },
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "note"
          ]
        }
      ],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "publication": {
          "type": "string",
          "minLength": 2
        },
        "note": {
          "type": "string",
          "minLength": 10,
          "maxLength": 160
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "svgShape",
        "parametricParams"
      ],
      "properties": {
        "svgShape": {
          "const": "retro-canvas"
        },
        "parametricParams": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "columns",
            "rows"
          ],
          "properties": {
            "kind": {
              "enum": [
                "columns",
                "quadrants",
                "zones",
                "rings",
                "timeline",
                "matrix",
                "fishbone",
                "tree",
                "bands"
              ]
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          }
        }
      }
    }
  }
}
