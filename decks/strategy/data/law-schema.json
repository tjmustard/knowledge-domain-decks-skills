{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/strategy-schema.json",
  "title": "Strategy Architecture card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "diagnosis",
    "schematic",
    "canvas",
    "stressTest",
    "stressTestFull",
    "checklist",
    "checklistFull",
    "origin",
    "figure"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^S(0[1-9]|[1-3][0-9]|4[0-2])$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "category": {
      "enum": [
        "Market & Competition",
        "Tech & Dynamics",
        "Defensibility",
        "Execution & Coherence"
      ]
    },
    "diagnosis": {
      "description": "The source's Strategic Diagnosis Question. Its measured range in the source is 105-202 characters; this bound leaves room for the longest without admitting a paragraph.",
      "type": "string",
      "minLength": 100,
      "maxLength": 220
    },
    "schematic": {
      "description": "The taxonomy matrix's compact schematic tag, as the table prints it.",
      "type": "string",
      "minLength": 8,
      "maxLength": 45
    },
    "canvas": {
      "description": "The section's full Canvas Schematic. The source's measured range is 152-283 characters; this is the form the rules file and skill resource carry unabridged.",
      "type": "string",
      "minLength": 150,
      "maxLength": 320
    },
    "stressTest": {
      "description": "Three pressure questions compressed to the card back. The card budget is measured by npm run check:fit; this bound is the back's line capacity, not a summary of the source.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 25,
            "maxLength": 96
          }
        }
      }
    },
    "stressTestFull": {
      "description": "The same three questions as the source states them. Printed in the rules file and skill resources so nothing is lost to the card's compression.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 40,
        "maxLength": 240
      }
    },
    "checklist": {
      "description": "Three actions compressed to the card back. A plain string, because the card renders this field as a declared list block, not as the ordered `items` field; the card budget is measured by npm run check:fit.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 25,
        "maxLength": 96
      }
    },
    "checklistFull": {
      "description": "The same three actions as the source states them, carried unabridged by the artifacts.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 40,
        "maxLength": 240
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "authors"
          ]
        },
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "note"
          ]
        },
        {
          "required": [
            "works"
          ]
        }
      ],
      "properties": {
        "works": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "authors"
                ]
              },
              {
                "required": [
                  "title"
                ]
              },
              {
                "required": [
                  "note"
                ]
              }
            ],
            "properties": {
              "authors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "year": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              "title": {
                "type": "string",
                "minLength": 2
              },
              "publication": {
                "type": "string",
                "minLength": 2
              },
              "note": {
                "type": "string",
                "minLength": 10,
                "maxLength": 160
              }
            }
          }
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "publication": {
          "type": "string",
          "minLength": 2
        },
        "note": {
          "type": "string",
          "minLength": 10,
          "maxLength": 160
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "svgShape",
        "parametricParams"
      ],
      "properties": {
        "svgShape": {
          "const": "strategy-canvas"
        },
        "parametricParams": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "columns",
            "rows"
          ],
          "properties": {
            "kind": {
              "enum": [
                "2x2",
                "stage_progression",
                "value_chain",
                "feedback_loop",
                "tree",
                "matrix_3x3"
              ]
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        }
      }
    }
  }
}
