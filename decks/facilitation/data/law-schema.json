{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/facilitation-schema.json",
  "title": "Facilitation Architecture card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "stage",
    "groupSize",
    "minutes",
    "difficulty",
    "deliverable",
    "atAGlance",
    "steps",
    "failure",
    "intervention",
    "provenance",
    "sourceProtocol",
    "origin",
    "figure"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WS-(0[1-9]|[1-4][0-9]|48)$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 70
    },
    "stage": {
      "enum": [
        "Alignment & Framing",
        "Divergent Ideation",
        "Convergent Decision",
        "Liberating Structures",
        "Action Planning"
      ]
    },
    "groupSize": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5
    },
    "minutes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "deliverable": {
      "type": "string",
      "minLength": 20,
      "maxLength": 140
    },
    "atAGlance": {
      "type": "string",
      "minLength": 8,
      "maxLength": 60
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 20,
            "maxLength": 170
          }
        }
      }
    },
    "failure": {
      "type": "string",
      "minLength": 20,
      "maxLength": 220
    },
    "intervention": {
      "type": "string",
      "minLength": 20,
      "maxLength": 220
    },
    "provenance": {
      "enum": [
        "Source protocol: the steps follow the written script in the source.",
        "Steps written for this deck from the method's public definition; the source has no protocol."
      ]
    },
    "sourceProtocol": {
      "type": "boolean"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "authors"
          ]
        },
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "note"
          ]
        }
      ],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "publication": {
          "type": "string",
          "minLength": 2
        },
        "note": {
          "type": "string",
          "minLength": 10,
          "maxLength": 160
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "svgShape",
        "parametricParams"
      ],
      "properties": {
        "svgShape": {
          "enum": [
            "framing-square",
            "divergent-fan",
            "convergent-funnel",
            "liberating-rings",
            "action-steps"
          ]
        },
        "parametricParams": {
          "type": "object"
        }
      }
    }
  }
}
